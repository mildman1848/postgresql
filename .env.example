# Copy to .env for local PostgreSQL image development.
# Never commit .env or generated secrets.

IMAGE_NAME=postgresql
APP_VERSION=18.4
IMAGE_REVISION=mldm4
REGISTRY=ghcr.io/mildman1848
PLATFORMS=linux/amd64,linux/arm64
LOAD_PLATFORM=linux/amd64
CONTAINER_NAME=postgresql-dev
POSTGRES_DB=app
POSTGRES_USER=postgres
TZ=Europe/Berlin
PUID=1000
PGID=1000
